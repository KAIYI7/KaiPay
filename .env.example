# =============================================================================
# KaiPay Environment Variables Template
# Copy this file to .env and adjust variables for your deployment environment.
# =============================================================================

# Server Port
PORT=28080

# PostgreSQL Database Configuration (Port 25432)
DB_URL=jdbc:postgresql://localhost:25432/kaipay
DB_USERNAME=kaipay
DB_PASSWORD=kaipay_secret

# Apache Kafka Broker Configuration (Port 29092)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Logging Level
LOG_LEVEL=INFO
