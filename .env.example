# =============================================================================
# KaiPay Environment Variables Template
# Reference values for local development; these are not deployment secrets.
# Java, Maven and the account CLI do not automatically read a root .env file.
# Export overrides in each process terminal; see backend/README.md.
# The explicit local profile already supplies these Compose connection defaults.
# The shipped Compose file uses literal values, not variables from this template.
# =============================================================================

# Server Port
PORT=28080

# PostgreSQL Database Configuration (Port 25432)
DB_URL=jdbc:postgresql://localhost:25432/kaipay
DB_USERNAME=kaipay
DB_PASSWORD=kaipay_secret

# Apache Kafka Broker Configuration (Port 29092)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Logging levels are configured in backend/src/main/resources/application.yaml.
